<Project Sdk="MSTest.Sdk/4.3.3">

    <PropertyGroup>
        <TargetFramework>net48</TargetFramework>
        <!-- A .NET Framework executable prefers 32 bits, and libnode is 64. -->
        <PlatformTarget>x64</PlatformTarget>
        <IsPackable>false</IsPackable>
        <TestingPlatformShowTestsFailure>true</TestingPlatformShowTestsFailure>
    </PropertyGroup>

    <ItemGroup>
        <!-- carries the VSTest testhost that CI's `dotnet test <dll>` runs -->
        <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.8.1" />
        <PackageReference Include="Microsoft.JavaScript.LibNode.win-x64" Version="20.1800.203" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\src\Alethic.AspNet.Optimization\Alethic.AspNet.Optimization.csproj" />
    </ItemGroup>

    <ItemGroup>
        <None Include="Fixtures\**" CopyToOutputDirectory="PreserveNewest" />
    </ItemGroup>

</Project>
